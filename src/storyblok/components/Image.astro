---
import StoryblokPicture from './StoryblokPicture.astro';
import type { Asset } from '../../types/storyblok';

interface Props {
  image: Asset;
  class?: string;
  wrapperClass?: string;
  captionClass?: string;
  widths?: number[];
  sizes?: string;
}

const { image, class: className, wrapperClass, captionClass, widths, sizes } = Astro.props;
---

<figure class={wrapperClass}>
  <StoryblokPicture
    x-data="{ shown: false }"
    x-intersect.threshold.25="shown = true"
    src={image.filename}
    alt={image.alt || ''}
    widths={widths}
    sizes={sizes}
    class={`block w-full transition-opacity duration-500 opacity-0 ${className || ''}`}
    :class="shown ? 'opacity-100' : 'opacity-0'"
  />
  {image.title && <figcaption class={captionClass}>{image.title}</figcaption>}
</figure>
