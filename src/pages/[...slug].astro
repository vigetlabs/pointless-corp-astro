---
import type { InferGetStaticParamsType } from 'astro';
import Application from '../layouts/Application.astro';
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import type { ProjectStory } from '../types/storyblok';
import { richTextParagraphs } from '../utils/richText';

export async function getStaticPaths() {
  const storyblokApi = useStoryblokApi();
  const { data } = await storyblokApi.get('cdn/stories', {
    version: 'published',
    content_type: 'project',
    per_page: 100,
  });

  const stories: ProjectStory[] = data.stories;

  return stories.map(({ full_slug }) => ({
    params: { slug: full_slug },
  }));
}

const { slug } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get(`cdn/stories/${slug}`, {
  version: 'published',
  resolve_assets: 1,
});
const story: ProjectStory = data.story;

const { data: projectData } = await storyblokApi.get('cdn/stories', {
  version: 'published',
  starts_with: '',
  filter_query: {
    component: {
      in: 'project'
    }
  },
  per_page: 12,
  sort_by: 'sort_by_date:desc,name:asc'
});
const projects: ProjectStory[] = projectData.stories;

// Extract theme colors from the story content
const themeColors = {
  backgroundColor: story.content.backgroundColor?.color,
  accentColor: story.content.accentColor?.color,
  textColor: story.content.textColor?.color,
  linkColor: story.content.linkColor?.color,
};

const description = richTextParagraphs(story.content.description)[0] ?? '';
---

<Application title={`${story.name} - Pointlesscorp`} themeColors={themeColors} description={description} metaImage={story.content.logo.filename} slug={slug}>
  <StoryblokComponent blok={story.content} name={story.name} projects={projects} />
</Application>
